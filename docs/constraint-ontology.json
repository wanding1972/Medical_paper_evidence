{
  "version": "0.1",
  "current_slice": "Product workflow: closed-corpus evidence audit",
  "precedence": [
    "explicit user constraints",
    "attached requirements as design inputs",
    "implementation defaults documented in ADR"
  ],
  "constraints": {
    "R1": {
      "kind": "boolean",
      "requirement": "All business predicates, filters, labels, severities, weights, thresholds and messages are configuration data; Python provides parsing algorithms and generic typed predicate execution only."
    },
    "R2": {
      "kind": "boolean",
      "requirement": "No business Python modules directly in src or evidence_check root; all modules belong to subpackages."
    },
    "R3": {
      "kind": "boolean",
      "requirement": "Acyclic static imports; cross-domain imports use api only; no dynamic imports, eval or exec."
    },
    "R4": {
      "kind": "boolean",
      "requirement": "contracts/common must not import business domains or application/infrastructure."
    }
  },
  "domains": {
    "document": "Text structure, citation anchors and reference resolution",
    "claim": "Validate explicitly selected candidate spans against original text",
    "evidence": "Cited-only fulltext retrieval and page-span verification",
    "audit": "Pure configurable decision evaluation"
  },
  "entities": {
    "DocumentInput": [
      "document_id",
      "text",
      "references",
      "claims",
      "language_mode",
      "authorized"
    ],
