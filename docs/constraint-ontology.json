  "current_scope": {
    "implemented": [
      "single-user web workbench",
      "DOCX/Markdown + text PDF parsing",
      "candidate extraction with typed metadata",
      "cited-only BM25 and original page spans",
      "grounded observations and eight-rule decision table",
      "human re-audit without overwriting original",
      "optional consented structured HTTPS model port",
      "encrypted durable tasks, restart recovery and expiry",
      "JSON/Markdown and PDF downloads",
      "independent evaluation tool and CI configuration"
    ],
    "external_acceptance": [
      "real provider integration with securely configured credentials",
      "authorized independent medical gold and blind evaluation",
      "real-user utility and willingness-to-pay study",
      "production privacy/security/copyright review"
    ],
    "non_goals": [
      "medical advice",
      "paper scores",
      "external evidence search",
      "patient record processing",
      "public paid SaaS before real-user validation"
    ]
  }
