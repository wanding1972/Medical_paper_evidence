{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Check annotation record",
  "type": "object",
  "required": [
    "record_id",
    "language_mode",
    "source_document_id",
    "claim_text",
    "claim_type",
    "citation_ids",
    "final_label",
    "annotation_status"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^[A-Z]{2}-[A-Z]{2}-[0-9]{3}$"},
    "language_mode": {"type": "string", "enum": ["zh-zh", "zh-en", "en-en"]},
    "source_document_id": {"type": "string"},
    "claim_location": {
      "type": "object",
      "properties": {
        "section": {"type": "string"},
        "paragraph_index": {"type": "integer", "minimum": 0},
        "sentence_index": {"type": "integer", "minimum": 0},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 0}
      }
    },
    "claim_text": {"type": "string", "minLength": 1},
    "claim_type": {
      "type": "string",
      "enum": ["prevalence", "association", "causality", "effectiveness", "safety", "prognosis", "diagnostic_accuracy"]
    },
    "assertion_strength": {"type": "string", "enum": ["descriptive", "association", "probable_causality", "strong_causality"]},
    "citation_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "qualifiers": {
      "type": "object",
      "properties": {
        "population": {"type": ["string", "null"]},
        "disease": {"type": ["string", "null"]},
        "intervention_or_exposure": {"type": ["string", "null"]},
        "outcome": {"type": ["string", "null"]},
        "time": {"type": ["string", "null"]}
      }
    },
    "evidence_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference_id", "source_file_id", "page", "text"],
        "properties": {
          "reference_id": {"type": "integer", "minimum": 1},
          "source_file_id": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "paragraph": {"type": ["integer", "null"], "minimum": 0},
          "text": {"type": "string"}
        }
      }
    },
    "final_label": {
      "type": "string",
      "enum": ["supported", "partially_supported", "contradicted", "unverified", "not_assessable"]
    },
    "rule_ids": {
      "type": "array",
      "items": {"type": "string", "enum": ["missing_citation", "unresolved_reference", "source_unavailable", "unsupported_claim", "scope_mismatch", "causality_overclaim", "direction_mismatch", "numeric_mismatch"]}
    },
    "annotation_status": {"type": "string", "enum": ["pending", "preannotated", "confirmed", "adjudicated"]},
    "annotator_id": {"type": ["string", "null"]},
    "adjudication_note": {"type": ["string", "null"]}
  }
}
